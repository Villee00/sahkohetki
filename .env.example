# Sähköhetki environment configuration

# Mock mode is convenient without credentials; set this to 0 for live API data.
# `npm run dev:mock` enables mock mode for that run regardless of this setting.
SAHKO_MOCK_DATA=1

# API keys are only required when SAHKO_MOCK_DATA=0.
# ENTSOE_TOKEN=your-entsoe-token-here
# FINGRID_API_KEY=your-fingrid-api-key-here
